;WARMING UP
G21 					; set units to mm
G90 					; set to absolute positioning
M80 					; turn on the power supply
G54 					; switch to first (machine) coordinate system
T0 					; select tool 0
G92 E0				; reset extruder
;
@set global.JobNozzleDiameter 1.6
@call MatchNozzleSize
;
@nosize
G1 X80.0 Y232 Z10 F3000.0	; move to start position
G1 E0.5				; undo retraction
G1 X30.0 E0.8999999999999999 F150		; extrude and move
G92 E0				; reset extruder
G1 X25.0 F900			; move to side a little
;G4 S2				; wait 2 seconds
G1 Z4 F5000 			; Move bed up a bit
G1 X20.0 				; move to side a little again
G1 Z2 F5000 			; Move bed up a bit
@size
;
G1 Z2 F3600
G92 E0 ; reset extruder
M82 ; set extruder to absolute mode
;
;
; GO TO START POINT AND GET READY:
G92 E0 ; Reset Extruder to 0
G1 F12 E-0.3 ; retract at retraction speed
G92 E-0.3 ; apply extra unretraction distance
G1 X123.25 Y124.53 F7200 ; move to first XY at rapid speed
G1 Z0.3 F3600 ; move to start Z at rapid speed
;
;
; PRINTING OF ALL LAYER CURVES:
G1 E0 F12 ; un-retract filament at retraction speed
G4 P{{perm.unretractPauseTime}}; pause for a moment
; starting layer 1
G92 E0 ; Reset Extruder to 0
G1 F1200 ; set print speed for this layer
